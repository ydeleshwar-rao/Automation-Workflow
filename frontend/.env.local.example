# ============================================================
# Frontend Environment Variables
# Copy this file to .env.local
# ============================================================

# Backend API URL (Express server)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Google sign-in ──────────────────────────────────────────
# Same OAuth client ID as GOOGLE_CLIENT_ID in the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Microsoft sign-in + company SSO ─────────────────────────
# Same Application (client) ID as MICROSOFT_CLIENT_ID in the backend.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# Everything else (DB connection, JWT secrets) lives in the
# BACKEND .env only — never expose those to the browser.
