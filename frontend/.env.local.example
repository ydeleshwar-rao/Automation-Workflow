# ============================================================
# Frontend Environment Variables
# Copy this file to .env.local
# ============================================================

# Backend API URL (Express server)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Auth provider ───────────────────────────────────────────
# postgres | supabase — must match DB_PROVIDER in the backend.
# Used for Google sign-in and forgot/update-password; email+password login always goes through the backend.
NEXT_PUBLIC_AUTH_PROVIDER=postgres

# ── Google sign-in (postgres provider) ──────────────────────
# Same OAuth client ID as GOOGLE_CLIENT_ID in the backend.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# ── Microsoft sign-in + company SSO (postgres provider) ─────
# Same Application (client) ID as MICROSOFT_CLIENT_ID in the backend. Leave empty to hide Microsoft.
NEXT_PUBLIC_MICROSOFT_CLIENT_ID=

# ── Supabase (only when NEXT_PUBLIC_AUTH_PROVIDER=supabase) ─
# Get from: supabase.com → Your Project → Settings → API
# NOTE: Only ANON key needed here. Service role key stays in backend only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Everything else (DB connection, JWT secrets, Supabase service role)
# lives in the BACKEND .env only — never expose those to the browser.
