{
  "name": "automation-workflow",
  "private": true,
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "bun run --filter '*' dev",
    "dev:frontend": "bun run --filter frontend dev",
    "dev:backend": "bun run --filter backend dev",
    "build": "bun run prisma:generate && bun run --filter '*' build",
    "build:frontend": "bun run --filter frontend build",
    "build:backend": "bun run prisma:generate && bun run --filter backend build",
    "start": "bun run --filter '*' start",
    "start:frontend": "bun run --filter frontend start",
    "start:backend": "bun run --filter backend start",
    "lint": "bun run --filter frontend lint",
    "test": "bun run --filter backend test",
    "prisma:generate": "prisma generate --schema backend/prisma/schema.prisma",
    "db:migrate": "bun run --filter backend db:migrate",
    "db:migrate:status": "bun run --filter backend db:migrate:status",
    "db:migrate:existing": "bun run --filter backend db:migrate:existing"
  },
  "trustedDependencies": [
    "@prisma/client",
    "@prisma/engines",
    "prisma",
    "protobufjs",
    "sharp",
    "unrs-resolver"
  ]
}
