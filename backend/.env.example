# ============================================================
# Backend Environment Variables
# Copy to .env.development / .env.production and fill in your values
# ============================================================

# ── Database (PostgreSQL + Prisma) ──────────────────────────
# DATABASE_URL — used by the app (Prisma client).
# DIRECT_URL   — used by Prisma migrations. Same value unless DATABASE_URL goes
#                through a connection pooler (then DIRECT_URL is the direct connection).
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/automation_workflow
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/automation_workflow

# ── Custom JWT Secrets ──────────────────────────────────────
# Generate strong random secrets:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Google sign-in ──────────────────────────────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: http://localhost:3000/auth/callback
# Same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# ── Microsoft sign-in + company SSO ─────────────────────────
# Entra admin center → App registrations → New registration:
#   Supported account types: "Any Entra ID tenant + personal Microsoft accounts"
#   Redirect URI — platform "Web": http://localhost:3000/auth/callback
#   Authentication → "Implicit grant and hybrid flows": tick "ID tokens", Save
# Use the "Application (client) ID". Same value as NEXT_PUBLIC_MICROSOFT_CLIENT_ID in the frontend.
MICROSOFT_CLIENT_ID=

# ── App mail: password-reset emails ─────────────────────────
# Leave SMTP_HOST empty in development — the reset link is printed in the backend log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── App ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:5000
# Public URL vendors post webhooks to (a tunnel URL in development). Defaults to BASE_URL.
PUBLIC_BASE_URL=
# All API routes are versioned under /api/v1 (see src/config/api.config.ts).
# Integration OAuth redirect URIs that point at this backend must include it, e.g.
#   ZOHO_REDIRECT_URI=http://localhost:5000/api/v1/zoho/callback

# ── Redis (for BullMQ workflow queue) ───────────────────────
REDIS_URL=redis://localhost:6379

# ── AI (email-template field labels) ────────────────────────
# Optional. Without it, templates use plain formatted labels.
OPENROUTER_API_KEY=
