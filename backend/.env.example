# ============================================================
# Backend Environment Variables
# Copy to .env.development / .env.production and fill in your values
# ============================================================

# ── Database provider ───────────────────────────────────────
# postgres  → any PostgreSQL server (local, Docker, Neon, RDS…). Auth uses the auth_users table.
# supabase  → Supabase (PostgREST + Supabase Auth). Needs the SUPABASE_* keys below.
# Must match NEXT_PUBLIC_AUTH_PROVIDER in the frontend.
DB_PROVIDER=postgres

# Database connection (used by the app and by Prisma migrations)
#   postgres: both point at your server, e.g.
#     postgresql://postgres:YOUR_PASSWORD@localhost:5432/automation_workflow
#   supabase: Supabase → Settings → Database
#     DATABASE_URL = pooler (port 6543, ?pgbouncer=true)   DIRECT_URL = direct (port 5432)
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/automation_workflow
DIRECT_URL=postgresql://postgres:YOUR_PASSWORD@localhost:5432/automation_workflow

# ── Supabase (only when DB_PROVIDER=supabase) ───────────────
# supabase.com → Your Project → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_KEY

# ── Custom JWT Secrets ──────────────────────────────────────
# Generate strong random secrets:
#   bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your_access_secret_here
JWT_REFRESH_SECRET=your_refresh_secret_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# ── Google sign-in (DB_PROVIDER=postgres) ───────────────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: http://localhost:3000/auth/callback
# Same value as NEXT_PUBLIC_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# ── App mail: password-reset emails (DB_PROVIDER=postgres) ──
# Leave SMTP_HOST empty in development — the reset link is printed in the backend log.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── App ─────────────────────────────────────────────────────
PORT=5000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
BASE_URL=http://localhost:5000

# ── Redis (for BullMQ workflow queue) ───────────────────────
REDIS_URL=redis://localhost:6379
