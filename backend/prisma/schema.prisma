// ─── GoHighLevel lead input ──────────────────────────────────────────────────

/// GHL access token per location; looked up by location_id only.
model GhlToken {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  location_id  String   @unique
  access_token String
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("ghl_tokens")
}

/// Inbox of inbound lead webhooks. client_id is a GHL location id (text, not a profile).
model LeadInputWebhook {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  client_id  String
  source     String   @default("unknown")
  payload    Json
  headers    Json     @default("{}")
  created_at DateTime @default(now()) @db.Timestamptz(6)

  @@index([client_id])
  @@map("lead_input_webhooks")
}

// ─── Polling engine ──────────────────────────────────────────────────────────

model PollingSubscription {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id     String    @db.Uuid
  node_id         String    @unique @db.Uuid
  user_id         String    @db.Uuid
  integration_key String
  event_key       String
  config          Json      @default("{}")
  /// Seconds between polls.
  poll_interval   Int       @default(300)
  /// ISO timestamp or vendor id of the newest record already processed.
  cursor_value    String?
  last_polled_at  DateTime? @db.Timestamptz(6)
  last_error      String?
  error_count     Int       @default(0)
  is_active       Boolean   @default(false)
  created_at      DateTime  @default(now()) @db.Timestamptz(6)
  updated_at      DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  workflow    Workflow            @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  node        WorkflowNode        @relation(fields: [node_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user        Profile             @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  seenRecords PollingSeenRecord[]

  @@index([workflow_id])
  @@index([user_id])
  @@index([is_active, error_count, last_polled_at])
  @@map("polling_subscriptions")
}

/// Vendor record ids already processed by a subscription (deduplication only).
model PollingSeenRecord {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscription_id String   @db.Uuid
  external_id     String
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  subscription PollingSubscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([subscription_id, external_id])
  @@map("polling_seen_records")
}

// ─── Dynamic webhook delivery attempts ───────────────────────────────────────

model WebhookAttempt {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  event_id        String   @db.Uuid
  attempt_no      Int
  response_status Int?
  error_message   String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  event WebhookEvent @relation(fields: [event_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([event_id])
  @@map("webhook_attempts")
}

// ─── Trigger watches (what to watch, not the vendor data itself) ─────────────

model GoogleFormWatch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  form_id        String
  last_synced_at DateTime? @db.Timestamptz(6)
  active         Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, form_id])
  @@map("google_form_watches")
}

model GoogleSheetWatch {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String    @db.Uuid
  spreadsheet_id String
  sheet_name     String    @default("Sheet1")
  /// new_row | new_or_updated_row | new_spreadsheet | new_worksheet
  trigger_type   String
  last_row_count Int       @default(0)
  last_synced_at DateTime? @db.Timestamptz(6)
  active         Boolean   @default(true)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  updated_at     DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user            Profile                     @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  rowFingerprints GoogleSheetRowFingerprint[]

  @@unique([user_id, spreadsheet_id, sheet_name, trigger_type])
  @@map("google_sheet_watches")
}

/// Hash of each row's content so the new_or_updated_row trigger can detect
/// changes without storing the sheet's data.
model GoogleSheetRowFingerprint {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  watch_id     String   @db.Uuid
  row_number   Int
  content_hash String
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  watch GoogleSheetWatch @relation(fields: [watch_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([watch_id, row_number])
  @@map("google_sheet_row_fingerprints")
}

model ZohoFormWebhook {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         String   @db.Uuid
  form_id         String
  webhook_url     String
  zoho_webhook_id String?
  active          Boolean  @default(true)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, form_id])
  @@map("zoho_form_webhooks")
}

// ─── Mail log ────────────────────────────────────────────────────────────────

model EmailLog {
  id            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String   @db.Uuid
  /// Kept nullable so logs survive deleting the SMTP connection.
  smtp_id       String?  @db.Uuid
  to_email      String
  cc            String[] @default([])
  bcc           String[] @default([])
  /// File names / metadata of attachments, never file contents.
  attachments   Json     @default("[]")
  subject       String
  /// success | failed
  status        String
  attempt_count Int      @default(1)
  error_message String?
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  user Profile         @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  smtp SmtpConnection? @relation(fields: [smtp_id], references: [id], onDelete: SetNull, onUpdate: NoAction)

  @@index([user_id])
  @@map("email_logs")
}

// ─── Access control ──────────────────────────────────────────────────────────

/// Which client accounts a developer is assigned to.
model UserClientAccess {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @db.Uuid
  client_user_id String   @db.Uuid
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  developer Profile @relation("AssignedDeveloper", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  client    Profile @relation("AssignedClient", fields: [client_user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([user_id, client_user_id])
  @@index([client_user_id])
  @@map("user_client_access")
}
