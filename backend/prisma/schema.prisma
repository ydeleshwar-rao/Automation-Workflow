// =============================================================================
// Prisma Schema — single source of truth for the database
//
// Conventions:
//   - Model names are PascalCase singular and mapped to the snake_case table.
//   - Field names are exactly the column names (snake_case). They are also the
//     JSON keys the API returns, so the frontend contract stays unchanged.
//   - Integration tables store CREDENTIALS / CONFIG only — never copies of
//     vendor data (jobs, customers, invoices…). Vendor data is fetched live.
//   - Check constraints and expression indexes live in the SQL migrations;
//     Prisma cannot express them, so edit those migrations by hand.
// =============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth & organizations ────────────────────────────────────────────────────

model AuthUser {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                  String
  password_hash          String?
  provider               String    @default("email")
  user_metadata          Json      @default("{}")
  reset_token_hash       String?
  reset_token_expires_at DateTime? @db.Timestamptz(6)
  last_sign_in_at        DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  identities AuthIdentity[]
  profile    Profile?

  @@index([reset_token_hash], map: "idx_auth_users_reset_token_hash")
  @@map("auth_users")
}

model AuthIdentity {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      String    @db.Uuid
  provider     String
  subject      String
  email        String?
  tenant_key   String?
  last_used_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  user AuthUser @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([provider, subject])
  @@index([user_id], map: "idx_auth_identities_user")
  @@map("auth_identities")
}

model Organization {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name         String
  owner_id     String?  @db.Uuid
  type         String   @default("individual")
  sso_required Boolean  @default(false)
  /// Admin switch: when false, workflows can't be tagged and tag UI is hidden.
  workflow_tags_enabled Boolean @default(true)
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  members        Profile[]
  ssoConnections OrganizationSsoConnection[]
  workflowTags   WorkflowTag[]

  @@map("organizations")
}

model OrganizationSsoConnection {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  organization_id String   @db.Uuid
  provider        String
  tenant_key      String
  domain          String
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  organization Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator      Profile?     @relation(fields: [created_by], references: [id], onUpdate: NoAction)

  @@unique([provider, tenant_key])
  @@index([organization_id], map: "idx_organization_sso_connections_org")
  @@map("organization_sso_connections")
}

model Profile {
  id              String   @id @db.Uuid
  email           String   @unique
  full_name       String   @default("")
  avatar_url      String?
  role            String   @default("developer")
  organization_id String   @db.Uuid
  is_active       Boolean  @default(true)
  created_by      String?  @db.Uuid
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  authUser        AuthUser     @relation(fields: [id], references: [id], onDelete: Cascade, onUpdate: NoAction, map: "profiles_auth_user_id_fkey")
  organization    Organization @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  creator         Profile?     @relation("ProfileCreator", fields: [created_by], references: [id], onUpdate: NoAction)
  createdProfiles Profile[]    @relation("ProfileCreator")

  pagePermissions        PagePermission[]            @relation("PermissionOwner")
  grantedPagePermissions PagePermission[]            @relation("PermissionGranter")
  createdSsoConnections  OrganizationSsoConnection[]

  commusoftIntegration CommusoftIntegration?
  servicem8Integration Servicem8Integration?
  simproIntegration    SimproIntegration?
  leadshubIntegrations LeadshubIntegration[]
  smtpConnections      SmtpConnection[]
  emailLogs            EmailLog[]

  googleFormsIntegration   GoogleFormsIntegration?
  googleSheetsIntegration  GoogleSheetsIntegration?
  zohoInventoryIntegration ZohoInventoryIntegration?
  zohoFormsIntegration     ZohoFormsIntegration?
  razorpayIntegration      RazorpayIntegration?
  googleFormWatches        GoogleFormWatch[]
  googleSheetWatches       GoogleSheetWatch[]
  zohoFormWebhooks         ZohoFormWebhook[]

  pollingSubscriptions PollingSubscription[]
  assignedClients      UserClientAccess[]    @relation("AssignedDeveloper")
  assignedDevelopers   UserClientAccess[]    @relation("AssignedClient")

  webhooks             Webhook[]
  webhookSubscriptions IntegrationWebhookSubscription[]
  workflows            Workflow[]                       @relation("WorkflowOwner")
  lastEditedWorkflows  Workflow[]                       @relation("WorkflowLastEditor")
  workflowFolders      WorkflowFolder[]
  workflowTags         WorkflowTag[]
  workflowTemplates    WorkflowTemplate[]
  templateFolders      TemplateFolder[]
  aiWorkflows          AiWorkflow[]

  @@index([organization_id], map: "idx_profiles_organization_id")
  @@map("profiles")
}

model PagePermission {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  page_key   String
  can_view   Boolean  @default(false)
  can_edit   Boolean  @default(false)
  can_delete Boolean  @default(false)
  granted_by String?  @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user    Profile  @relation("PermissionOwner", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  granter Profile? @relation("PermissionGranter", fields: [granted_by], references: [id], onUpdate: NoAction)

  @@unique([user_id, page_key])
  @@map("page_permissions")
}

// ─── Integration credentials (no vendor data) ────────────────────────────────

model CommusoftIntegration {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        String   @unique @db.Uuid
  client_id      String?
  username       String?
  password       String?
  application_id String?
  access_token   String?
  needs_reauth   Boolean  @default(false)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("commusoft_integrations")
}

model Servicem8Integration {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          String    @unique @db.Uuid
  access_token     String
  refresh_token    String?
  expires_at       DateTime? @db.Timestamptz(6)
  scopes           String?
  sm8_account_uuid String?
  needs_reauth     Boolean   @default(false)
  last_synced_at   DateTime? @db.Timestamptz(6)
  created_at       DateTime  @default(now()) @db.Timestamptz(6)
  updated_at       DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("servicem8_integrations")
}

model SimproIntegration {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @unique @db.Uuid
  build_name    String    @default("")
  base_url      String    @default("")
  company_id    Int       @default(0)
  access_token  String    @default("")
  refresh_token String?
  expires_at    DateTime? @db.Timestamptz(6)
  scopes        String?
  needs_reauth  Boolean   @default(false)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("simpro_integrations")
}

model LeadshubIntegration {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       String    @db.Uuid
  company_id    String?
  location_id   String?
  access_token  String?
  refresh_token String?
  expires_in    BigInt?
  expires_at    DateTime? @db.Timestamptz(6)
  user_type     String?
  is_active     Boolean   @default(true)
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  updated_at    DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user Profile @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("leadshub_integrations")
}

/// Baileys WhatsApp session per user. user_id is text with no foreign key.
model WhatsappSession {
  user_id        String   @id
  phone_number   String?
  status         String   @default("disconnected")
  webhook_url    String?
  webhook_secret String?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@map("whatsapp_sessions")
}

/// Baileys signal-protocol key store, one row per user and key.
model WhatsappAuthKey {
  user_id  String
  key_id   String
  key_data Json

  @@id([user_id, key_id])
  @@index([user_id], map: "idx_whatsapp_auth_keys_user")
  @@map("whatsapp_auth_keys")
}

// ─── Mail ────────────────────────────────────────────────────────────────────

model SmtpConnection {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            String   @db.Uuid
  name               String
  host               String
  port               Int
  username           String
  encrypted_password String
  use_tls            Boolean  @default(true)
  status             String   @default("active")
  total_sent         Int      @default(0)
  total_failed       Int      @default(0)
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user      Profile    @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  emailLogs EmailLog[]

  @@map("smtp_connections")
}

// ─── Dynamic webhooks (user-created inbound URLs) ────────────────────────────

model Webhook {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id           String    @db.Uuid
  name              String
  unique_path       String    @unique
  method            String    @default("POST")
  secret_token      String?
  is_active         Boolean   @default(true)
  action_type       String?
  action_config     Json      @default("{}")
  mode              String    @default("test")
  status            String    @default("active")
  full_url          String?
  workflow_id       String?   @db.Uuid
  last_triggered_at DateTime? @db.Timestamptz(6)
  expires_at        DateTime? @db.Timestamptz(6)
  deleted_at        DateTime? @db.Timestamptz(6)
  created_at        DateTime  @default(now()) @db.Timestamptz(6)
  updated_at        DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user     Profile        @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  workflow Workflow?      @relation(fields: [workflow_id], references: [id], onUpdate: NoAction)
  events   WebhookEvent[]

  @@map("webhooks")
}

model WebhookEvent {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  webhook_id      String?   @db.Uuid
  request_headers Json?
  request_body    Json?
  status          String    @default("pending")
  error_message   String?
  received_at     DateTime  @default(now()) @db.Timestamptz(6)
  processed_at    DateTime? @db.Timestamptz(6)

  webhook  Webhook?         @relation(fields: [webhook_id], references: [id], onUpdate: NoAction)
  attempts WebhookAttempt[]

  @@map("webhook_events")
}

// ─── Vendor webhook engine (push events from ServiceM8, simPRO, Commusoft) ──

model IntegrationWebhookSubscription {
  id                       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id              String    @db.Uuid
  node_id                  String    @unique @db.Uuid
  user_id                  String    @db.Uuid
  integration_key          String
  event_key                String
  config                   Json      @default("{}")
  external_subscription_id String?
  target_path              String
  signing_secret           String?
  is_active                Boolean   @default(true)
  last_received_at         DateTime? @db.Timestamptz(6)
  total_received           Int       @default(0)
  error_count              Int       @default(0)
  last_error               String?
  created_at               DateTime  @default(now()) @db.Timestamptz(6)
  updated_at               DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  workflow Workflow          @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  node     WorkflowNode      @relation(fields: [node_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  user     Profile           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  events   WebhookEventLog[]

  @@map("integration_webhook_subscriptions")
}

model WebhookEventLog {
  id                String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  subscription_id   String    @db.Uuid
  external_event_id String?
  event_type        String?
  payload           Json?
  status            String    @default("received")
  processed_at      DateTime? @db.Timestamptz(6)
  error             String?
  received_at       DateTime  @default(now()) @db.Timestamptz(6)

  subscription IntegrationWebhookSubscription @relation(fields: [subscription_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("webhook_event_log")
}

// ─── Workflows ───────────────────────────────────────────────────────────────

model WorkflowFolder {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    String   @db.Uuid
  name       String
  parent_id  String?  @db.Uuid
  position   Int      @default(0)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user       Profile          @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  parent     WorkflowFolder?  @relation("WorkflowFolderTree", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subfolders WorkflowFolder[] @relation("WorkflowFolderTree")
  workflows  Workflow[]

  @@map("workflow_folders")
}

model Workflow {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                String    @db.Uuid
  folder_id              String?   @db.Uuid
  name                   String
  status                 String    @default("draft")
  version                Int       @default(1)
  tag                    String?
  position               Int       @default(0)
  last_edited_by_user_id String?   @db.Uuid
  last_edited_by_name    String?
  last_edited_at         DateTime? @db.Timestamptz(6)
  created_at             DateTime  @default(now()) @db.Timestamptz(6)
  updated_at             DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user         Profile         @relation("WorkflowOwner", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  lastEditedBy Profile?        @relation("WorkflowLastEditor", fields: [last_edited_by_user_id], references: [id], onUpdate: NoAction)
  folder       WorkflowFolder? @relation(fields: [folder_id], references: [id], onUpdate: NoAction)

  nodes                WorkflowNode[]
  executions           WorkflowExecution[]
  tagLinks             WorkflowTagLink[]
  webhooks             Webhook[]
  webhookSubscriptions IntegrationWebhookSubscription[]
  derivedTemplates     WorkflowTemplate[]
  pollingSubscriptions PollingSubscription[]

  @@map("workflows")
}

model WorkflowNode {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id     String   @db.Uuid
  type            String
  integration_key String
  action_key      String
  config          Json     @default("{}")
  position        Int
  node_category   String   @default("action")
  sample_payload  Json     @default("{}")
  output_schema   Json     @default("{}")
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  workflow            Workflow                        @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  fieldMapping        WorkflowFieldMapping?
  webhookSubscription IntegrationWebhookSubscription?
  pollingSubscription PollingSubscription?
  executionLogs       WorkflowExecutionLog[]

  @@map("workflow_nodes")
}

model WorkflowFieldMapping {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_node_id String   @unique @db.Uuid
  mappings         Json     @default("[]")
  created_at       DateTime @default(now()) @db.Timestamptz(6)

  node WorkflowNode @relation(fields: [workflow_node_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("workflow_field_mappings")
}

model WorkflowExecution {
  id              String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id     String?   @db.Uuid
  status          String    @default("running")
  trigger_payload Json?
  started_at      DateTime  @default(now()) @db.Timestamptz(6)
  finished_at     DateTime? @db.Timestamptz(6)

  workflow Workflow?              @relation(fields: [workflow_id], references: [id], onUpdate: NoAction)
  logs     WorkflowExecutionLog[]

  @@map("workflow_executions")
}

model WorkflowExecutionLog {
  id              String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  execution_id    String   @db.Uuid
  workflow_id     String?  @db.Uuid
  node_id         String   @db.Uuid
  node_position   Int?
  integration_key String?
  action_key      String?
  log_level       String   @default("info")
  resolved_value  String?
  status          String
  error_message   String?
  created_at      DateTime @default(now()) @db.Timestamptz(6)

  execution WorkflowExecution @relation(fields: [execution_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  node      WorkflowNode      @relation(fields: [node_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("workflow_execution_logs")
}

model WorkflowTag {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Company the tag is shared with; only its admins manage it.
  organization_id String @db.Uuid
  /// Admin who created the tag.
  user_id    String   @db.Uuid
  name       String
  color      String?
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user         Profile           @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  organization Organization      @relation(fields: [organization_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  links        WorkflowTagLink[]

  @@index([organization_id], map: "idx_workflow_tags_organization_id")
  @@map("workflow_tags")
}

model WorkflowTagLink {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id String   @db.Uuid
  tag_id      String   @db.Uuid
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  workflow Workflow    @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  tag      WorkflowTag @relation(fields: [tag_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@unique([workflow_id, tag_id])
  @@map("workflow_tag_links")
}

// ─── Workflow templates ──────────────────────────────────────────────────────

model TemplateFolder {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name        String
  description String?
  parent_id   String?  @db.Uuid
  created_by  String?  @db.Uuid
  is_public   Boolean  @default(false)
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  creator    Profile?           @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  parent     TemplateFolder?    @relation("TemplateFolderTree", fields: [parent_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  subfolders TemplateFolder[]   @relation("TemplateFolderTree")
  templates  WorkflowTemplate[]

  @@map("template_folders")
}

model WorkflowTemplate {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name               String
  description        String?
  category           String?
  tag                String?
  source_workflow_id String?  @db.Uuid
  created_by         String?  @db.Uuid
  is_public          Boolean  @default(false)
  usage_count        Int      @default(0)
  status             String   @default("active")
  template_folder_id String?  @db.Uuid
  created_at         DateTime @default(now()) @db.Timestamptz(6)
  updated_at         DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  creator        Profile?                  @relation(fields: [created_by], references: [id], onUpdate: NoAction)
  sourceWorkflow Workflow?                 @relation(fields: [source_workflow_id], references: [id], onUpdate: NoAction)
  folder         TemplateFolder?           @relation(fields: [template_folder_id], references: [id], onUpdate: NoAction)
  nodes          WorkflowTemplateNode[]
  mappings       WorkflowTemplateMapping[]

  @@map("workflow_templates")
}

model WorkflowTemplateNode {
  id                   String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id          String   @db.Uuid
  type                 String
  node_category        String?
  integration_key      String
  action_key           String?
  config_schema        Json?
  required_credentials Json?
  output_schema        Json?
  position             Int
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  template WorkflowTemplate          @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  mappings WorkflowTemplateMapping[]

  @@map("workflow_template_nodes")
}

model WorkflowTemplateMapping {
  id               String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  template_id      String   @db.Uuid
  template_node_id String   @db.Uuid
  mappings         Json?
  created_at       DateTime @default(now()) @db.Timestamptz(6)
  updated_at       DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  template     WorkflowTemplate     @relation(fields: [template_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  templateNode WorkflowTemplateNode @relation(fields: [template_node_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@map("workflow_template_mappings")
}

// ─── AI workflow builder ─────────────────────────────────────────────────────

model AiWorkflow {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     String   @db.Uuid
  name        String
  description String?
  status      String   @default("draft")
  nodes       Json     @default("[]")
  edges       Json     @default("[]")
  viewport    Json?
  created_at  DateTime @default(now()) @db.Timestamptz(6)
  updated_at  DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user       Profile               @relation(fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  executions AiWorkflowExecution[]

  @@index([user_id, updated_at(sort: Desc)], map: "idx_ai_workflows_user_updated")
  @@map("ai_workflows")
}

model AiWorkflowExecution {
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  workflow_id  String?   @db.Uuid
  status       String    @default("pending")
  trigger      String    @default("manual")
  node_results Json?
  error        String?
  started_at   DateTime  @default(now()) @db.Timestamptz(6)
  finished_at  DateTime? @db.Timestamptz(6)

  workflow AiWorkflow? @relation(fields: [workflow_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([workflow_id, started_at(sort: Desc)], map: "idx_ai_workflow_executions_workflow_started")
  @@map("ai_workflow_executions")
}

