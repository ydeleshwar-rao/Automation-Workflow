# ============================================================
# Frontend Environment Variables
# Copy this file to .env.local
# ============================================================

# Backend API URL (Express server)
NEXT_PUBLIC_API_URL=http://localhost:5000

# ── Supabase (auth-only — for forgot-password / update-password flows) ──────
# Get from: supabase.com → Your Project → Settings → API
# NOTE: Only ANON key needed here. Service role key stays in backend only.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here

# Everything else (Supabase service role, DB connection, JWT secrets)
# lives in the BACKEND .env only — never expose those to the browser.
